# ---- Core (required in production) ----
ENVIRONMENT=development            # development | production
SECRET_KEY=change-me               # random string of at least 32 characters; required in production
DATABASE_URL=sqlite+aiosqlite:///./sms.db   # Render Postgres URL in production
ALLOWED_ORIGINS=["http://localhost:4200"]   # JSON list; "*" is refused in production

# ---- Security (phase 5.3) ----
# Host names the API answers to, JSON list (e.g. ["sms.example.com"]). Required in production; "*" is refused there.
TRUSTED_HOSTS=["*"]
# Largest request body accepted, in bytes (larger requests get 413).
MAX_BODY_BYTES=12000000
# true only behind a trusted proxy (for example Render): the client IP is then the last X-Forwarded-For entry (the one the proxy added).
TRUST_PROXY_HEADERS=false
# Account lockout for platform accounts and as the starting value for new schools.
# Each school changes its own values on the School profile page (3 to 10 attempts, 5 to 1440 minutes).
LOGIN_MAX_ATTEMPTS_DEFAULT=3
LOGIN_LOCKOUT_MINUTES_DEFAULT=60
# Requests per minute per client IP (sign-in, token refresh, password change; every other API path).
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REFRESH_PER_MINUTE=30
RATE_LIMIT_CHANGE_PASSWORD_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=300

# ---- Optional: first platform super admin (created once, only if no users exist) ----
FIRST_SUPERADMIN_EMAIL=
FIRST_SUPERADMIN_PASSWORD=

# ---- Optional integrations: leave empty to keep the feature off ----
# Payments (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# SMS
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_DLT_ENTITY_ID=
# WhatsApp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Email (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# File storage (S3-compatible)
STORAGE_BUCKET=
STORAGE_KEY=
STORAGE_SECRET=
