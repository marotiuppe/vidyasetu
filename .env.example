# ---- Core (required in production) ----
ENVIRONMENT=development            # development | production
SECRET_KEY=change-me               # random string of at least 32 characters; required in production
DATABASE_URL=sqlite+aiosqlite:///./sms.db   # Render Postgres URL in production
ALLOWED_ORIGINS=["http://localhost:4200"]   # JSON list; "*" is refused in production

# ---- Security (phase 5.3) ----
# Host names the API answers to, JSON list (e.g. ["sms.example.com"]). Required in production; "*" is refused there.
TRUSTED_HOSTS=["*"]
# Largest request body accepted, in bytes (larger requests get 413).
MAX_BODY_BYTES=12000000
# true only behind a trusted proxy (for example Render): the client IP is then the last X-Forwarded-For entry (the one the proxy added).
TRUST_PROXY_HEADERS=false
# Account lockout for platform accounts and as the starting value for new schools.
# Each school changes its own values on the School profile page (3 to 10 attempts, 5 to 1440 minutes).
LOGIN_MAX_ATTEMPTS_DEFAULT=3
LOGIN_LOCKOUT_MINUTES_DEFAULT=60
# Requests per minute per client IP (sign-in, token refresh, password change; every other API path).
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REFRESH_PER_MINUTE=30
RATE_LIMIT_CHANGE_PASSWORD_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=300

# ---- Optional: first platform super admin (created once, only if no users exist) ----
FIRST_SUPERADMIN_EMAIL=
FIRST_SUPERADMIN_PASSWORD=

# ---- Optional integrations: leave empty to keep the feature off ----
# Payments (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# SMS
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_DLT_ENTITY_ID=
# WhatsApp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Email (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# File storage (S3-compatible)
STORAGE_BUCKET=
STORAGE_KEY=
STORAGE_SECRET=

# ---- Legal and contact details (phase 5.5, optional) ----
# Shown on the public legal pages (GET /api/v1/public/legal) and in /.well-known/security.txt.
# Leave empty until the owner has confirmed them. Public pages count as configured when
# OPERATOR_NAME and GRIEVANCE_OFFICER_EMAIL are both set.
# Legal name of the platform operator (the processor) and its postal address.
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=
OPERATOR_PHONE=
# Grievance officer under the IT Act 2000 / SPDI Rules 2011 and the DPDP Act 2023.
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=
GRIEVANCE_OFFICER_PHONE=
# Days within which grievances are answered (default 15).
GRIEVANCE_RESPONSE_DAYS=15
# Where vulnerability reports go (security.txt Contact). Without it, /.well-known/security.txt returns 404.
SECURITY_CONTACT_EMAIL=
PRIVACY_CONTACT_EMAIL=
# Where the data is hosted, for example "Singapore (Render)". Shown on the privacy page.
HOSTING_REGION=
# Date from which the published policies apply, YYYY-MM-DD.
POLICY_EFFECTIVE_DATE=
# Optional free-text note on how long data is kept.
DATA_RETENTION_NOTE=
