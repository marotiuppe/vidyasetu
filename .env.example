# ---- Core (required in production) ----
ENVIRONMENT=development            # development | production
SECRET_KEY=change-me               # long random string; required when ENVIRONMENT=production
DATABASE_URL=sqlite+aiosqlite:///./sms.db   # Render Postgres URL in production
ALLOWED_ORIGINS=["http://localhost:4200"]

# ---- Optional: first platform super admin (created once, only if no users exist) ----
FIRST_SUPERADMIN_EMAIL=
FIRST_SUPERADMIN_PASSWORD=

# ---- Optional integrations: leave empty to keep the feature off ----
# Payments (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# SMS
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_DLT_ENTITY_ID=
# WhatsApp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Email (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# File storage (S3-compatible)
STORAGE_BUCKET=
STORAGE_KEY=
STORAGE_SECRET=
